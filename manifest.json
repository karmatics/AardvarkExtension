{
  "manifest_version": 3,
  "name": "Aardvark",
  "version": "1.0.0",
  "description": "Aardvark YouTube Player & Multi-Track Music Visualizer Companion",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "bookmarks",
    "scripting",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://localhost/*",
    "*://127.0.0.1/*",
    "*://*.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aardvark",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "config.js",
        "content/YouTubeContent.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://*.github.io/AardvarkPlaylist/*",
        "*://*.github.io/*"
      ],
      "js": [
        "config.js",
        "content/PlayerBridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}